{
  "ConnectionStrings": {
    "DefaultConnection": "Data Source=SubmarineData.sqlite"

  },

  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },

  // This is where we can store the devices various thresholds so that all controllers and such can access them
  "DeviceThresholds": {
    "Oxygen": {
      "VeryLow": 18,
      "Low": 19.5,
      "High": 23.5,
      "VeryHigh": 25
    },
    "CO2": {
      "High": 1000,
      "VeryHigh": 2000
    },
    "inPressure": {
      "High": 24,
      "VeryHigh": 36
    },
    "exPressure": {
      "High": 20,
      "VeryHigh": 30
    },
    "Humidity": {
      "VeryLow": 30,
      "Low": 35,
      "High": 55,
      "VeryHigh": 60
    },
    "Temperature": {
      "VeryLow": 13,
      "Low": 15,
      "High": 23,
      "VeryHigh": 25
    },
    "AirReserves": {
      "VeryLow": 15,
      "Low": 50
    }
  },

  "AllowedHosts": "*"
}